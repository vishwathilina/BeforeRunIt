# BeforeRunIt for zsh. Generated by `beforerunit init zsh`; add to ~/.zshrc:
#   eval "$(beforerunit init zsh)"
# Draws a risk line under the prompt while you type. Toggle with @TOGGLE_NAME@.
# Talks to the daemon over its socket (zsh/net/socket), so typing never forks.

[[ -o interactive ]] || return 0
(( ${+__bri_loaded} )) && return 0
[[ ${TERM-} == dumb ]] && return 0
typeset -g __bri_loaded=1

typeset -g __bri_bin=@BIN@
typeset -g __bri_sock=@SOCK@
typeset -g __bri_display=@DISPLAY@
typeset -g __bri_sid="zsh-$$-${RANDOM}${RANDOM}"
typeset -g __bri_mode= __bri_last=$'\0' __bri_text= __bri_specs= __bri_post=
typeset -g __bri_fd= __bri_sub= __bri_has_sock=0
typeset -gi __bri_seq=0 __bri_retry=0
typeset -ga __bri_rh

if [[ -n ${NO_COLOR-} ]]; then
  typeset -g __bri_caps=n
elif [[ ${COLORTERM-} == (*truecolor*|*24bit*) ]]; then
  typeset -g __bri_caps=ti
elif [[ ${TERM-} == (*256color*|*kitty*|*alacritty*|*ghostty*|*wezterm*) ]]; then
  typeset -g __bri_caps=2i
else
  typeset -g __bri_caps=1
fi

zmodload zsh/net/socket 2>/dev/null && __bri_has_sock=1
zmodload -F zsh/datetime p:EPOCHSECONDS 2>/dev/null

__bri_esc() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//$'\t'/\\t}
  s=${s//$'\n'/\\n}
  REPLY=${s//$'\r'/\\r}
}

__bri_disconnect() {
  [[ -n $__bri_fd ]] && exec {__bri_fd}>&-
  if [[ -n $__bri_sub ]]; then
    zle -F $__bri_sub 2>/dev/null
    exec {__bri_sub}>&-
  fi
  __bri_fd= __bri_sub=
}

__bri_connect() {
  [[ -n $__bri_fd ]] && return 0
  (( __bri_has_sock )) || return 1
  (( ${EPOCHSECONDS:-0} < __bri_retry )) && return 1
  __bri_retry=$(( ${EPOCHSECONDS:-0} + 2 ))
  if ! zsocket $__bri_sock 2>/dev/null; then
    ( "$__bri_bin" daemon >/dev/null 2>&1 & )
    return 1
  fi
  __bri_fd=$REPLY
  if zsocket $__bri_sock 2>/dev/null; then
    __bri_sub=$REPLY
    __bri_esc $__bri_sid
    print -r -u $__bri_sub -- "S"$'\t'"$REPLY"
    zle -F -w $__bri_sub __bri_on_push 2>/dev/null
  fi
  return 0
}

# Parses "R seq text specs" into __bri_text/__bri_specs if seq is current.
__bri_take() {
  local -a f
  f=("${(@ps:\t:)1}")
  [[ $f[1] == R && $f[2] == $__bri_seq ]] || return 1
  __bri_text=${(g::)f[3]}
  __bri_specs=${(g::)f[4]}
  return 0
}

__bri_query() {
  local reply line eb ep
  if __bri_connect; then
    __bri_esc "$BUFFER"; eb=$REPLY
    __bri_esc "$PWD"; ep=$REPLY
    if print -r -u $__bri_fd -- "Q"$'\t'"$__bri_sid"$'\t'"$__bri_seq"$'\t'"${COLUMNS:-80}"$'\t'"$__bri_caps"$'\t'"$__bri_mode"$'\t'"$ep"$'\t'"$EUID"$'\t'"$eb" 2>/dev/null; then
      # Skip late replies to earlier keystrokes.
      while read -r -t 0.2 -u $__bri_fd reply; do
        __bri_take "$reply" && return 0
      done
    fi
    __bri_disconnect
  fi
  reply=$("$__bri_bin" query --shell zsh --cols "${COLUMNS:-80}" --caps "$__bri_caps" --mode "$__bri_mode" -- "$BUFFER" 2>/dev/null)
  __bri_take "R"$'\t'"$__bri_seq"$'\t'"$reply"
}

__bri_detach() {
  if [[ -n $__bri_post && $POSTDISPLAY == *"$__bri_post" ]]; then
    POSTDISPLAY=${POSTDISPLAY%"$__bri_post"}
  fi
  (( $#__bri_rh )) && region_highlight=( ${region_highlight:|__bri_rh} )
  __bri_rh=()
  __bri_post=
}

# Appends the ghost line after anything else in POSTDISPLAY (autosuggestions).
__bri_attach() {
  [[ -z $__bri_text ]] && return 0
  local base=$(( ${#BUFFER} + ${#POSTDISPLAY} + 1 )) s
  local -a p
  __bri_post=$'\n'$__bri_text
  POSTDISPLAY+=$__bri_post
  for s in ${(s:|:)__bri_specs}; do
    p=(${=s})
    (( $#p >= 3 )) && __bri_rh+=("$(( base + p[1] )) $(( base + p[2] )) $p[3]")
  done
  region_highlight+=( $__bri_rh )
}

__bri_redraw() {
  __bri_detach
  if [[ $BUFFER != "$__bri_last" ]]; then
    __bri_last=$BUFFER
    (( __bri_seq++ ))
    __bri_query || { __bri_text= __bri_specs= }
  fi
  __bri_attach
}

__bri_on_push() {
  local fd=${1:-$__bri_sub} reply
  if ! read -r -u $fd reply; then
    zle -F $fd 2>/dev/null
    exec {fd}>&-
    [[ $fd == $__bri_sub ]] && __bri_sub=
    return 0
  fi
  __bri_take "$reply" || return 0
  __bri_detach
  __bri_attach
  zle -R
}

__bri_line_init() {
  (( __bri_seq++ ))
  __bri_last=$'\0'
  __bri_text= __bri_specs= __bri_post=
  __bri_rh=()
}

__bri_line_finish() {
  (( __bri_seq++ ))
  __bri_detach
  __bri_text= __bri_specs=
  if [[ -n $__bri_fd ]]; then
    __bri_esc $__bri_sid
    print -r -u $__bri_fd -- "X"$'\t'"$REPLY" 2>/dev/null || __bri_disconnect
  fi
}

__bri_toggle() {
  case ${__bri_mode:-$__bri_display} in
    always) __bri_mode=risky-only ;;
    risky-only) __bri_mode=off ;;
    *) __bri_mode=always ;;
  esac
  __bri_last=$'\0'
  __bri_redraw
  zle -R
}

__bri_exit() {
  if [[ -n $__bri_fd ]]; then
    __bri_esc $__bri_sid
    print -r -u $__bri_fd -- "E"$'\t'"$REPLY" 2>/dev/null
  fi
}

zle -N __bri_redraw
zle -N __bri_on_push
zle -N __bri_line_init
zle -N __bri_line_finish
zle -N __bri_toggle

if autoload -Uz add-zle-hook-widget 2>/dev/null && (( ${+functions[add-zle-hook-widget]} )); then
  add-zle-hook-widget line-pre-redraw __bri_redraw
  add-zle-hook-widget line-init __bri_line_init
  add-zle-hook-widget line-finish __bri_line_finish
else
  zle -N zle-line-pre-redraw __bri_redraw
  zle -N zle-line-init __bri_line_init
  zle -N zle-line-finish __bri_line_finish
fi
bindkey @TOGGLE@ __bri_toggle
autoload -Uz add-zsh-hook && add-zsh-hook zshexit __bri_exit

[[ -S $__bri_sock ]] || ( "$__bri_bin" daemon >/dev/null 2>&1 & )
