# BeforeRunIt for fish. Generated by `beforerunit init fish`; add to
# ~/.config/fish/config.fish:
#   beforerunit init fish | source
# Draws a risk line under the prompt while you type. Toggle with @TOGGLE_NAME@.

status is-interactive; or return 0
set -q __bri_loaded; and return 0
test "$TERM" = dumb; and return 0
set -g __bri_loaded 1

set -g __bri_bin @BIN@
set -g __bri_display @DISPLAY@
set -g __bri_sid fish-$fish_pid-(random)
set -g __bri_mode ''
set -g __bri_last ''
set -g __bri_drawn ''
set -g __bri_pw 0
set -g __bri_pwok ''
set -g __bri_euid (string match -rg 'Uid:\s+\d+\s+(\d+)' </proc/$fish_pid/status; or echo 1000)

if set -q NO_COLOR; and test -n "$NO_COLOR"
    set -g __bri_caps n
else if string match -qr 'truecolor|24bit' -- "$COLORTERM"
    set -g __bri_caps ti
else if string match -qr '256color|kitty|alacritty|ghostty|wezterm' -- "$TERM"
    set -g __bri_caps 2i
else
    set -g __bri_caps 1
end

function __bri_paint
    set -l line (commandline -b | string collect)
    if test -z "$__bri_pwok"; and test (string length -- "$line") -gt (math "$COLUMNS / 2")
        set -g __bri_pw (string length --visible -- (fish_prompt)[-1])
        set -g __bri_pwok 1
    end
    set -l flags
    test -n "$__bri_drawn"; and set flags --drawn
    set -l out ("$__bri_bin" query --shell fish $flags --cols $COLUMNS --point (commandline -C) \
        --pw $__bri_pw --sid $__bri_sid --mode "$__bri_mode" --cwd $PWD --euid $__bri_euid \
        --pid $fish_pid --caps $__bri_caps -- "$line" 2>/dev/null | string collect)
    test "$out" = "$__bri_last"; and return
    set -g __bri_last "$out"
    if string match -q -- "*"\eD"*" "$out"
        set -g __bri_drawn 1
    else if test -n "$out"
        set -g __bri_drawn ''
    end
    test -n "$out"; and printf '%s' "$out" >/dev/tty
end

function __bri_clear
    if test -n "$__bri_drawn"
        "$__bri_bin" query --shell fish --drawn --clear --cols $COLUMNS --point (commandline -C) \
            --pw $__bri_pw --sid $__bri_sid -- (commandline -b | string collect) >/dev/tty 2>/dev/null
    end
    set -g __bri_drawn ''
    set -g __bri_last ''
end

function __bri_toggle
    switch (test -n "$__bri_mode"; and echo $__bri_mode; or echo $__bri_display)
        case always
            set -g __bri_mode risky-only
        case risky-only
            set -g __bri_mode off
        case '*'
            set -g __bri_mode always
    end
    __bri_paint
end

function __bri_prompt --on-event fish_prompt
    set -g __bri_drawn ''
    set -g __bri_last ''
    set -g __bri_pwok ''
end

function __bri_preexec --on-event fish_preexec
    set -g __bri_drawn ''
    set -g __bri_last ''
end

function __bri_bind
    # fish 4 names keys (ctrl-w); fish 3 binds raw sequences (\cw).
    if string match -qr '^[0-3]\.' -- $version
        set -f k_bs \x7f; set -f k_ch \b; set -f k_del \e\[3~; set -f k_w \cw
        set -f k_u \cu; set -f k_k \ck; set -f k_y \cy; set -f k_up \e\[A
        set -f k_down \e\[B; set -f k_right \e\[C; set -f k_tab \t; set -f k_cr \r
        set -f k_lf \n; set -f k_cc \cc; set -f k_toggle @TOGGLE3@
    else
        set -f k_bs backspace; set -f k_ch ctrl-h; set -f k_del delete; set -f k_w ctrl-w
        set -f k_u ctrl-u; set -f k_k ctrl-k; set -f k_y ctrl-y; set -f k_up up
        set -f k_down down; set -f k_right right; set -f k_tab tab; set -f k_cr enter
        set -f k_lf ctrl-j; set -f k_cc ctrl-c; set -f k_toggle @TOGGLE@
    end
    set -l cancel cancel-commandline
    functions -q __fish_cancel_commandline; and set cancel __fish_cancel_commandline
    for mode in default insert
        bind -M $mode '' self-insert __bri_paint 2>/dev/null
        bind -M $mode ' ' self-insert expand-abbr __bri_paint 2>/dev/null
        bind -M $mode $k_bs backward-delete-char __bri_paint 2>/dev/null
        bind -M $mode $k_ch backward-delete-char __bri_paint 2>/dev/null
        bind -M $mode $k_del delete-char __bri_paint 2>/dev/null
        bind -M $mode $k_w backward-kill-path-component __bri_paint 2>/dev/null
        bind -M $mode $k_u backward-kill-line __bri_paint 2>/dev/null
        bind -M $mode $k_k kill-line __bri_paint 2>/dev/null
        bind -M $mode $k_y yank __bri_paint 2>/dev/null
        bind -M $mode $k_up up-or-search __bri_paint 2>/dev/null
        bind -M $mode $k_down down-or-search __bri_paint 2>/dev/null
        bind -M $mode $k_right forward-char __bri_paint 2>/dev/null
        bind -M $mode $k_tab complete __bri_paint 2>/dev/null
        bind -M $mode $k_cr __bri_clear execute 2>/dev/null
        bind -M $mode $k_lf __bri_clear execute 2>/dev/null
        bind -M $mode $k_cc __bri_clear $cancel 2>/dev/null
        bind -M $mode $k_toggle __bri_toggle 2>/dev/null
    end
end
__bri_bind

# Bracketed paste goes through __fish_paste; refresh after it.
if functions -q __fish_paste; and not functions -q __bri_orig_paste
    functions -c __fish_paste __bri_orig_paste
    function __fish_paste
        __bri_orig_paste $argv
        __bri_paint
    end
end
